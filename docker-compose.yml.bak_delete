services:
  app:
    build: .
    restart: unless-stopped
    environment:
      - APP_USER=acervo
      - APP_PASSWORD=Video0102
      - DATA_DIR=/data
      - ADMIN_PASSWORD=!0Cdv...
    volumes:
      - ./data:/data
      - /opt/acervo/videos:/videos:ro   # <- ajuste este caminho
    expose:
      - "8000"

  caddy:
    image: caddy:2
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - app

volumes:
  caddy_data:
  caddy_config:
